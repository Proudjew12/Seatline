{
  "name": "seatline-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite --config config/vite.config.ts --host 127.0.0.1",
    "build": "tsc -b && vite build --config config/vite.config.ts",
    "preview": "vite preview --config config/vite.config.ts --host 127.0.0.1",
    "lint": "eslint --config config/eslint.config.js . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test": "playwright test --config config/playwright.config.ts",
    "test:install": "playwright install chromium"
  },
  "dependencies": {
    "@dnd-kit/collision": "0.5.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "jspdf": "4.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "sass": "1.104.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2"
  }
}
